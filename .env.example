VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server only. Use a test key during development.
PAYMONGO_SECRET_KEY=sk_test_replace_me
# Server only. Signing secret from the matching test/live PayMongo webhook.
PAYMONGO_WEBHOOK_SECRET=replace-with-webhook-signing-secret

# Server only. Supabase Project Settings > API. Never prefix these with VITE_.
# Set either the legacy service role key or the newer secret key.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# SUPABASE_SECRET_KEY=sb_secret_replace_me
AUTH_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Used only by run-schema.cjs. Keep the real value in .env.local.
DATABASE_URL=postgresql://user:password@host:5432/database
